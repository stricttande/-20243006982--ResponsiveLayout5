<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_default_background"
    android:orientation="vertical">

    <TextView
        android:id="@+id/municipalityName"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/color_default_background"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textColor="@color/color_text_dark"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/municipalityImage"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:contentDescription="@string/city_image_description"
        android:scaleType="centerCrop" />

    <ScrollView
        android:id="@+id/informationScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:id="@+id/informationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.15"
            android:padding="20dp"
            android:textColor="@color/color_text_dark"
            android:textSize="16sp" />

    </ScrollView>

    <Button
        android:id="@+id/visitSiteButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:minHeight="52dp"
        android:text="@string/visit_site" />

</LinearLayout>
